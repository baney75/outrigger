{
  "manifest_version": 3,
  "name": "Outrigger — T3 Code beside you",
  "description": "Continue your T3 Code sessions as you browse. Answer questions and attach selected page context.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["sidePanel", "storage", "alarms", "activeTab", "scripting"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Open Outrigger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Open Outrigger"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
  }
}
